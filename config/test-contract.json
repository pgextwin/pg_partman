{
  "contractVersion": 2,
  "extension": "pg_partman",
  "smokeTest": {
    "script": "windows/ci/smoke-test.ps1"
  },
  "runtimeRequirements": {
    "extensionCreation": "required",
    "preload": "optional",
    "backgroundWorker": true,
    "clientExecutable": {
      "required": false,
      "packagePaths": []
    }
  },
  "testSetup": {
    "preload": "shared",
    "backgroundWorker": true,
    "settings": [
      {
        "name": "pg_partman_bgw.dbname",
        "value": "postgres"
      },
      {
        "name": "pg_partman_bgw.role",
        "value": "partman_maintainer"
      },
      {
        "name": "pg_partman_bgw.interval",
        "value": "2"
      },
      {
        "name": "pg_partman_bgw.jobmon",
        "value": "off"
      }
    ]
  },
  "coverage": {
    "createExtension": "covered",
    "backgroundWorker": "covered",
    "clientExecutable": "not-applicable",
    "serverLogAssertions": "covered",
    "upgrade": "not-covered"
  },
  "functionalScenarios": [
    {
      "id": "partition-maintenance-routing",
      "description": "Create and maintain a time-partitioned parent, verify routed INSERTs and child partitions",
      "evidence": [
        "sql-result"
      ]
    },
    {
      "id": "sql-without-preload",
      "description": "Verify SQL partition routing remains functional without loading the optional BGW DLL.",
      "evidence": [
        "sql-result"
      ]
    },
    {
      "id": "bgw-automatic-partition-replenishment",
      "description": "Preload optional Windows background worker and verify an unprivileged maintenance role automatically replenishes a deliberately removed partition on PostgreSQL 14–18.",
      "evidence": [
        "background-worker-side-effect",
        "sql-result",
        "server-log"
      ]
    }
  ]
}
